# Electron / electron-builder 二进制国内镜像（npmmirror）
# 会注入为 npm_config_electron_mirror 等，供 @electron/get、electron-builder 读取
# 不要用 node-options --require=./scripts/...：依赖包 lifecycle 的 cwd 在 node_modules 下，相对路径会 MODULE_NOT_FOUND
# npm 11+ 可能提示 Unknown project config（可忽略，不影响安装）
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
